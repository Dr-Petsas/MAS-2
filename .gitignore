# Dependencies
node_modules/
.pnp/
.venv/
.venv-*/

# Env & secrets (never commit)
.env
.env.*
!.env.example
secrets/
*service-account*.json
firebaseServiceAccountKey.json

# Build output
dist/
build/
.next/
out/
coverage/

# Data / DB (tenant data stays out of git)
*.db
*.sqlite
*.sqlite3
data/
uploads/
# ABER: backend/src/data ist versionierte Konfiguration (QM-Katalog etc.),
# KEIN Mandantendatum — muss in Git (Vorfall 05.07.2026: Ordner war nur
# lokal, wurde bei Aufraeumarbeiten geloescht, Wiederherstellung noetig).
!backend/src/data/
!backend/src/data/**

# Logs
*.log
logs/
.devserver.*

# Caches
.cache/
__pycache__/
*.pyc

# Lokale Verifikations-Screenshots (UI-Checks)
backend/scripts/shots/

# OS / editor artifacts
.DS_Store
Thumbs.db
AlbumArtSmall.jpg
Folder.jpg
.idea/
.run/

# OCR-Sprachdaten (Tesseract, binaer, per Download holen - nie committen)
*.traineddata
