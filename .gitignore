# Dependencies
node_modules/
.pnp/
.venv/
.venv-*/

# Env & secrets (never commit)
.env
.env.*
!.env.example
secrets/
*service-account*.json
firebaseServiceAccountKey.json

# Build output
dist/
build/
.next/
out/
coverage/

# Data / DB (tenant data stays out of git)
*.db
*.sqlite
*.sqlite3
data/
uploads/
# ABER: backend/src/data ist versionierte Konfiguration (QM-Katalog etc.),
# KEIN Mandantendatum — muss in Git (Vorfall 05.07.2026: Ordner war nur
# lokal, wurde bei Aufraeumarbeiten geloescht, Wiederherstellung noetig).
!backend/src/data/
!backend/src/data/**
backend/src/data/dens-drop/

# Logs
*.log
logs/
.devserver.*

# Caches
.cache/
__pycache__/
*.pyc

# Lokale Verifikations-Screenshots (UI-Checks)
backend/scripts/shots/

# OS / editor artifacts
.DS_Store
Thumbs.db
AlbumArtSmall.jpg
Folder.jpg
.idea/
.run/

# OCR-Sprachdaten (Tesseract, binaer, per Download holen - nie committen)
*.traineddata

# Clara Live-Replay: echte Anruf-WAVs (lokal generiert, nicht committen)
backend/public/m/replay-audio/
backend/public/m/replay-audio-dev/
# ... und die daraus erzeugten Seiten (echte Gespraechstexte mit Patientennamen)
backend/public/m/clara-replay.html
backend/public/m/clara-replay-dev.html

# PVS-Warteschlange zur Laufzeit (echte Patienten- und Anamnesedaten)
backend/src/data/pvs-pending-chart.json

# Ablage fuer Dokumente/Bilder, die der Chef dem Agenten gibt
_posteingang/

# Neustart-Logs, Debug-Screenshots, DENS-Analyse-Artefakte
*.log.err
backend/public/img/_shot-*
backend/public/img/_debug-*.html
backend/scripts/dens-*.png
backend/scripts/dens-*-strings.txt
backend/scripts/dens-ui-dump.txt
# DENS-Fremdsoftware (DENSimport, lizenziert, 19 MB) - lokal vorhalten
backend/scripts/_densimport/
backend/scripts/_densimport.zip
# Hilfsprogramme werden aus den .cs-Quellen gebaut; nur das zur Laufzeit
# gebrauchte DensUiDeliver.exe (src/pvs/densUiWrite.js) liegt im Repo
backend/scripts/*.exe
!backend/scripts/DensUiDeliver.exe
