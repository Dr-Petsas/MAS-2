  "reprozessierungsKlassen": {
    "description": "Hoechste Einstufung der aufzubereitenden Instrumente (KRINKO/BfArM 'Anforderungen an die Aufbereitung von Medizinprodukten'). Steuert Umfang von Sterilisationsbuch, validierten Prozessen und Aufbereitungs-SOP. Mit ausfuehrlicher Beschreibung, damit z. B. ein operativ taetiger Zahnarzt sich korrekt einstuft.",
    "klassen": [
      { "value": "", "label": "Keine eigene Aufbereitung", "beschreibung": "Es werden keine wiederverwendbaren Medizinprodukte selbst aufbereitet (nur Einmalprodukte oder externe Aufbereitung)." },
      { "value": "unkritisch", "label": "Unkritisch", "beschreibung": "Produkte, die nur mit intakter Haut in Beruehrung kommen (z. B. Blutdruckmanschette, Ablageflaechen). Reinigung/Desinfektion genuegt, keine Sterilisation." },
      { "value": "semikritisch_a", "label": "Semikritisch A", "beschreibung": "Kontakt mit Schleimhaut oder krankhaft veraenderter Haut, glatte Oberflaeche, leicht aufbereitbar (z. B. Mundspiegel, Abformloeffel). Reinigung + Desinfektion, ggf. thermisch." },
      { "value": "semikritisch_b", "label": "Semikritisch B", "beschreibung": "Wie A, aber schwer aufbereitbar (enge/lange Lumen, komplexe Geometrie, z. B. Uebertragungsinstrumente/Winkelstuecke, flexible Endoskope ohne Gewebekontakt). Validierte, dokumentierte Verfahren erforderlich." },
      { "value": "kritisch_a", "label": "Kritisch A", "beschreibung": "Durchdringen Haut/Schleimhaut, Kontakt mit Blut/Gewebe/inneren Organen, glatt und gut aufbereitbar (z. B. Skalpellgriffe, Pinzetten, Zangen). Reinigung/Desinfektion + Sterilisation (dampfsterilisiert), validiert." },
      { "value": "kritisch_b", "label": "Kritisch B", "beschreibung": "Wie Kritisch A, aber schwer aufbereitbar (Hohlkoerper/Lumen, z. B. chirurgische Uebertragungsinstrumente, Trepanbohrer, OP-Sauger). Nur mit validierten Verfahren, hoehere Anforderungen an RDG/Autoklav (Klasse B) und Dokumentation. GILT AUCH FUER OPERATIV TAETIGE ZAHNAERZTE ohne Facharzttitel Oralchirurgie." }
    ]
  },

