# Path to the Firebase service-account key (NOT committed). For local dev you may
# point this at the existing Pickadoc service account, e.g. the one bundled with
# the voice repo:
#   GOOGLE_APPLICATION_CREDENTIALS=F:\TelefonKI v5.2\secrets\docgenda-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=

# Cloud Storage bucket for mail attachments & letter archiving. Defaults to
# "<project_id>.appspot.com" derived from the service account; set explicitly if
# your project uses a different bucket (e.g. "<project_id>.firebasestorage.app").
FIREBASE_STORAGE_BUCKET=

# Default tenant used when no X-Client-Id header / body clientId is provided.
# med dent Zahnklinik (test client).
DEFAULT_CLIENT_ID=MEe4ZQHEzOPzLcexyhdT

# HTTP port for the tools backend.
PORT=4000

# --- Authentication (see src/auth.js) -------------------------------------
# Logged-in platform users authenticate with their Firebase ID token (verified
# server-side; tenant + admin come from the token's claims). Enforcement is ON
# automatically when NODE_ENV=production. Set MAS_REQUIRE_AUTH=1 to enforce it
# locally too (0/unset = dev mode: unauthenticated calls act as practice admin).
MAS_REQUIRE_AUTH=

# Shared secret for trusted server-to-server callers (voice worker / agent tool
# webhooks / scheduled jobs) sent as the "X-Service-Token" header. Grants
# practice (admin) scope for the X-Client-Id they target. Use a long random
# value in production; leave empty to disable the service path.
MAS_SERVICE_TOKEN=

# Comma-separated allowed browser origins for CORS in production (e.g.
# "https://ca.pickadoc.de"). Default "*" is for local dev only.
ALLOWED_ORIGINS=

# Crypto key (32-byte hex) for encrypting mail account passwords at rest.
# REQUIRED once you add mail accounts. Generate: openssl rand -hex 32
MAIL_CRYPTO_KEY=

# Public base URL used to build the QR / connect links.
PUBLIC_BASE_URL=http://127.0.0.1:4000

# Clara voice channel. Defaults match the bundled local LiveKit SFU dev creds
# (deploy/livekit/livekit.yaml in the voice repo). Use real creds in prod.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=pickadoc-dev-key
LIVEKIT_API_SECRET=pickadoc-dev-secret-2026-05-30-rotate-before-prod-a1b2c3d4e5f6
LIVEKIT_TOKEN_TTL_S=3600

# Voice profile the worker loads for Clara (folder name under voice/profiles/).
CLARA_PROFILE_ID=clara_meddent

# --- Local LLM (Nadine's brain — see src/mail/llm.js) ----------------------
# DSGVO: Nadine's writing/classification run on a LOCAL model (Qwen via Ollama),
# OpenAI-compatible API. Patient data must NOT leave the practice network.
# Defaults point at a local Ollama; override only to another on-prem/LAN host.
MAS_LLM_BASE_URL=http://127.0.0.1:11434/v1
MAS_LLM_MODEL=qwen3:4b-instruct
MAS_LLM_API_KEY=ollama
# Nadine's strong writing/summarising brain (letters, passage rewrite, e-mail
# summaries for Clara's read_email). DEFAULT is now the RTX-5090 server (vLLM,
# OpenAI-compatible, qwen3.6:35b-a3b) over the Tailscale overlay — that host
# counts as LOCAL for the DSGVO guard (CGNAT 100.64.0.0/10), so patient content
# still never leaves the private network. There is NO fallback to the weaker
# local qwen3:8b: if the 5090 is unreachable, Nadine degrades to a deterministic
# template, not to a weaker model. Override these only to move the server.
MAS_LETTER_BASE_URL=http://100.77.30.98:8000/v1
MAS_LETTER_MODEL=qwen3.6:35b-a3b
# Optional override for inbound-mail classification (falls back to MAS_LLM_MODEL).
MAS_CLASSIFY_MODEL=
# --- OCR für hochgeladene Scans/Fotos (Hybrid) ------------------------------
# Bild-Uploads werden gelesen: erst ein optionaler Vision-Endpoint, sonst lokal
# Tesseract (reines WASM, kein GPU, Bild bleibt lokal). Das reine TEXT-Modell
# qwen3.6:35b-a3b kann KEIN Bild lesen — dafür braucht es ein VL-Modell.
#
# GEWÄHLTES SETUP (16.07.2026): qwen3.6 bleibt DAUERHAFT der Schreiber mit
# max_model_len 32768. Vision (qwen-vl, 3B-AWQ) läuft ON-DEMAND in eigenem
# Container auf Port 8001 — Start per Wake-URL, Idle-Stop auf dem Server.
# Dauerhaft parallel passt 35B@32k + VL NICHT in 32 GB VRAM.
# Details: docs/5090-vision-ocr-ondemand.md
#
# Dann hier eintragen (Port != 11434 => openai/vLLM-Modus automatisch):
#   MAS_OCR_VISION_BASE_URL=http://100.77.30.98:8001/v1
#   MAS_OCR_VISION_MODEL=qwen-vl
#   MAS_OCR_VISION_WAKE_URL=http://100.77.30.98:8010/wake-vl
#   MAS_OCR_VISION_STARTUP_WAIT_MS=90000
# Test:  node scripts/test-vision-ocr.mjs <bild.png|.jpg>
# Leer lassen = nur Tesseract lokal (kein VRAM-Bedarf, DSGVO-konform).
MAS_OCR_VISION_BASE_URL=
MAS_OCR_VISION_MODEL=qwen-vl
MAS_OCR_VISION_API_KEY=ollama
# Endpoint-Art: auto (Port 11434 => ollama, sonst openai) | ollama | openai
MAS_OCR_VISION_KIND=auto
# On-demand-Container: URL, die den gestoppten VL-Container startet (Box-seitig),
# und wie lange MAS beim Hochfahren auf Bereitschaft wartet (ms).
MAS_OCR_VISION_WAKE_URL=
MAS_OCR_VISION_WAKE_METHOD=GET
MAS_OCR_VISION_STARTUP_WAIT_MS=90000
# Nur relevant, falls du doch Ollama nutzt (keep_alive; 0 = sofort entladen).
MAS_OCR_VISION_KEEP_ALIVE=0
# Tesseract-Sprachen (Trainingsdaten werden einmalig geladen) und optional ein
# lokaler Pfad zu *.traineddata (für Offline-Installationen).
MAS_OCR_LANG=deu+eng
MAS_OCR_LANG_PATH=
# Hard DSGVO guard: set to 1 to REFUSE startup if the LLM endpoint is not on a
# local/private (RFC1918 / .local) host — prevents a misconfigured cloud URL
# from ever receiving patient content. Leave empty to only warn.
MAS_LLM_REQUIRE_LOCAL=

# --- Web-Push: "Clara ruft aufs Handy" (see src/clara/devices.js) -----------
# VAPID key pair, generated ONCE with: npx web-push generate-vapid-keys
# Do NOT rotate later — all paired phones would lose their subscriptions.
# Web-Push + the pairing pages require PUBLIC_BASE_URL to be HTTPS.
MAS_VAPID_PUBLIC_KEY=
MAS_VAPID_PRIVATE_KEY=
MAS_VAPID_SUBJECT=mailto:info@pickadoc.de

# --- Lisa: Outbound-Telefonistin (see src/lisa/outbound.js) -----------------
# Clara delegiert per Sprachbefehl SMS + Anrufe an Lisa. SMS gehen ueber die
# Twilio Messages API (alphanumerischer Absender, max. 11 Zeichen, kein
# Rueckkanal); Anrufe ueber den ElevenLabs-ConvAI-Agenten "Lisa" auf der
# Praxis-Twilio-Nummer. Leer lassen = Funktion deaktiviert.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
LISA_SMS_SENDER=
# Voice-From (E.164) fuer „Gespräch übernehmen“. LISA_SMS_SENDER ist
# alphanumerisch und kann NICHT als Anruferkennung dienen. Leer = From
# der laufenden Lisa-Leitung bzw. die ElevenLabs-Praxisnummer.
TWILIO_VOICE_FROM=
# Chef-Handy, das bei „Gespräch übernehmen“ klingelt (E.164). Leer = die
# App fragt einmal und merkt sich die Nummer am Gerät.
LISA_TAKEOVER_PHONE=
ELEVENLABS_API_KEY=
LISA_AGENT_ID=
LISA_PHONE_NUMBER_ID=
